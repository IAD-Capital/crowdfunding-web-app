DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iadcapital_db_local
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

JWT_SECRET=change-me-in-production

# Google Sign-In (OAuth 2.0 Client ID, "Web application" type) — create at
# https://console.cloud.google.com/apis/credentials. Add http://localhost:3000
# and your production origin under "Authorized JavaScript origins" (no client
# secret needed — verification uses this public client ID as the audience).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase Storage (used for image uploads in production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=uploads

# Nodemailer / Gmail (used to email admins/users on signup and investment events)
# MAIL_PASSWORD is a 16-character App Password, not the account password —
# generate one at https://myaccount.google.com/apppasswords (requires 2FA enabled
# on the same Google account as MAIL_USER).
MAIL_USER=your-address@gmail.com
MAIL_PASSWORD=your-app-password
# Public URL of the app, used to build links in emails
MAIL_APP_URL=http://localhost:3000

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY (read client-side to subscribe)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-address@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
